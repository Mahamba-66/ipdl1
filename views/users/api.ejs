
<div class="container my-5">
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-key me-2"></i>Votre token API</h4>
        </div>
        <div class="card-body">
          <% if(apiToken) { %>
            <div class="alert alert-success">
              <p class="mb-1">Token actif</p>
              <small>Généré le <%= new Date(user.tokenCreatedAt).toLocaleDateString() %></small>
            </div>
            <div class="mb-3">
              <label class="form-label">Votre token</label>
              <div class="input-group">
                <input 
                  type="text" 
                  class="form-control" 
                  value="<%= apiToken %>" 
                  id="apiTokenField" 
                  readonly
                >
                <button 
                  class="btn btn-outline-secondary" 
                  type="button" 
                  onclick="copyToClipboard('apiTokenField')"
                >
                  <i class="fas fa-copy"></i>
                </button>
              </div>
              <div class="form-text">Ce token est valable pendant 30 jours.</div>
            </div>
            <form action="/auth/generate-token" method="POST">
              <button type="submit" class="btn btn-outline-info w-100">
                <i class="fas fa-sync-alt me-2"></i>Régénérer le token
              </button>
            </form>
          <% } else { %>
            <div class="alert alert-warning">
              <p class="mb-0">Vous n'avez pas de token API actif</p>
            </div>
            <form action="/auth/generate-token" method="POST">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-key me-2"></i>Générer un token
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0"><i class="fas fa-book me-2"></i>Documentation API</h4>
        </div>
        <div class="card-body">
          <div class="alert alert-info">
            <p class="mb-0">Cette API vous permet d'accéder aux fonctionnalités de la bibliothèque en ligne via des requêtes HTTP.</p>
          </div>
          
          <h5 class="mt-4">Authentification</h5>
          <p>Toutes les requêtes API nécessitent une authentification via le token API. Ajoutez le header suivant à chaque requête :</p>
          <div class="bg-light p-3 rounded mb-3">
            <code>Authorization: Bearer votre_token_api</code>
          </div>
          
          <h5 class="mt-4">Endpoints disponibles</h5>
          
          <div class="accordion" id="apiAccordion">
            <!-- Livres -->
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingBooks">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBooks" aria-expanded="true" aria-controls="collapseBooks">
                  <i class="fas fa-book me-2"></i>Livres
                </button>
              </h2>
              <div id="collapseBooks" class="accordion-collapse collapse show" aria-labelledby="headingBooks" data-bs-parent="#apiAccordion">
                <div class="accordion-body">
                  <!-- Liste des livres -->
                  <div class="card mb-3">
                    <div class="card-header">
                      <span class="badge bg-success">GET</span>
                      <code>/api/books</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Récupérer la liste des livres</p>
                      <h6>Paramètres optionnels :</h6>
                      <ul>
                        <li><code>search</code> - Recherche par titre, auteur ou ISBN</li>
                        <li><code>category</code> - Filtrer par catégorie</li>
                        <li><code>page</code> - Numéro de page (défaut: 1)</li>
                        <li><code>limit</code> - Nombre de résultats par page (défaut: 10)</li>
                      </ul>
                    </div>
                  </div>
                  
                  <!-- Détails d'un livre -->
                  <div class="card mb-3">
                    <div class="card-header">
                      <span class="badge bg-success">GET</span>
                      <code>/api/books/:id</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Récupérer les détails d'un livre spécifique</p>
                    </div>
                  </div>
                  
                  <!-- Emprunter un livre -->
                  <div class="card mb-3">
                    <div class="card-header">
                      <span class="badge bg-warning text-dark">POST</span>
                      <code>/api/books/:id/emprunter</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Emprunter un livre</p>
                    </div>
                  </div>
                  
                  <!-- Retourner un livre -->
                  <div class="card">
                    <div class="card-header">
                      <span class="badge bg-warning text-dark">POST</span>
                      <code>/api/books/:id/retourner</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Retourner un livre emprunté</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Profil -->
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingProfile">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProfile" aria-expanded="false" aria-controls="collapseProfile">
                  <i class="fas fa-user me-2"></i>Profil utilisateur
                </button>
              </h2>
              <div id="collapseProfile" class="accordion-collapse collapse" aria-labelledby="headingProfile" data-bs-parent="#apiAccordion">
                <div class="accordion-body">
                  <!-- Profil utilisateur -->
                  <div class="card">
                    <div class="card-header">
                      <span class="badge bg-success">GET</span>
                      <code>/api/profile</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Récupérer les informations de votre profil, y compris les emprunts en cours et l'historique</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <h5 class="mt-4">Exemples d'utilisation</h5>
          
          <div class="bg-light p-3 rounded mb-3">
            <p class="mb-2"><strong>Récupérer tous les livres :</strong></p>
            <code>
              curl -X GET "http://localhost:3000/api/books" \<br>
              -H "Authorization: Bearer votre_token_api"
            </code>
          </div>
          
          <div class="bg-light p-3 rounded mb-3">
            <p class="mb-2"><strong>Récupérer les détails d'un livre :</strong></p>
            <code>
              curl -X GET "http://localhost:3000/api/books/id_du_livre" \<br>
              -H "Authorization: Bearer votre_token_api"
            </code>
          </div>
          
          <div class="bg-light p-3 rounded">
            <p class="mb-2"><strong>Emprunter un livre :</strong></p>
            <code>
              curl -X POST "http://localhost:3000/api/books/id_du_livre/emprunter" \<br>
              -H "Authorization: Bearer votre_token_api"
            </code>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function copyToClipboard(elementId) {
    const copyText = document.getElementById(elementId);
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(copyText.value);
    
    // Afficher une notification
    alert('Token copié dans le presse-papiers');
  }
</script>

<div class="container my-5">
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-user me-2"></i>Profil</h4>
        </div>
        <div class="card-body">
          <h5><%= user.prenom %> <%= user.nom %></h5>
          <p class="text-muted"><%= user.email %></p>
          <p><small>Membre depuis : <%= new Date(user.dateInscription).toLocaleDateString() %></small></p>
          <div class="d-grid gap-2">
            <a href="/profile/edit" class="btn btn-outline-primary">
              <i class="fas fa-edit me-2"></i>Modifier le profil
            </a>
            <a href="/profile/password" class="btn btn-outline-secondary">
              <i class="fas fa-key me-2"></i>Changer le mot de passe
            </a>
          </div>
        </div>
      </div>
      
      <div class="card shadow-sm mt-4">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0"><i class="fas fa-key me-2"></i>API</h4>
        </div>
        <div class="card-body">
          <% if(apiToken) { %>
            <div class="alert alert-success">
              <p class="mb-1">Votre token API est actif</p>
              <small>Généré le <%= new Date(user.tokenCreatedAt).toLocaleDateString() %></small>
            </div>
          <% } else { %>
            <div class="alert alert-warning">
              <p class="mb-0">Vous n'avez pas de token API actif</p>
            </div>
          <% } %>
          <form action="/auth/generate-token" method="POST" class="d-grid gap-2">
            <button type="submit" class="btn btn-outline-info">
              <i class="fas fa-sync-alt me-2"></i><%= apiToken ? 'Régénérer le token' : 'Générer un token' %>
            </button>
            <a href="/profile/api" class="btn btn-outline-secondary">
              <i class="fas fa-book me-2"></i>Documentation API
            </a>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
          <h4 class="mb-0"><i class="fas fa-book-reader me-2"></i>Emprunts en cours</h4>
        </div>
        <div class="card-body">
          <% if(user.empruntActuel.length > 0) { %>
            <div class="row">
              <% user.empruntActuel.forEach(function(book) { %>
                <div class="col-md-6 mb-3">
                  <div class="card h-100">
                    <div class="row g-0">
                      <div class="col-4">
                        <img src="<%= book.image %>" class="img-fluid rounded-start" alt="<%= book.titre %>">
                      </div>
                      <div class="col-8">
                        <div class="card-body">
                          <h5 class="card-title"><%= book.titre %></h5>
                          <p class="card-text"><small class="text-muted"><%= book.auteur %></small></p>
                          <div class="d-flex justify-content-between">
                            <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-primary">
                              <i class="fas fa-info-circle me-1"></i>Détails
                            </a>
                            <form action="/books/<%= book._id %>/retourner" method="POST">
                              <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-undo me-1"></i>Retourner
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Vous n'avez aucun emprunt en cours.</p>
            </div>
            <div class="text-center">
              <a href="/books" class="btn btn-primary">
                <i class="fas fa-book me-2"></i>Parcourir le catalogue
              </a>
            </div>
          <% } %>
        </div>
      </div>
      
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h4 class="mb-0"><i class="fas fa-history me-2"></i>Historique des emprunts</h4>
        </div>
        <div class="card-body">
          <% if(user.historique.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Livre</th>
                    <th>Emprunté le</th>
                    <th>Retourné le</th>
                  </tr>
                </thead>
                <tbody>
                  <% user.historique.forEach(function(record) { %>
                    <% if(record.livre) { %>
                      <tr>
                        <td>
                          <a href="/books/<%= record.livre._id %>"><%= record.livre.titre %></a>
                          <small class="text-muted d-block"><%= record.livre.auteur %></small>
                        </td>
                        <td><%= new Date(record.dateEmprunt).toLocaleDateString() %></td>
                        <td>
                          <% if(record.dateRetour) { %>
                            <%= new Date(record.dateRetour).toLocaleDateString() %>
                          <% } else { %>
                            <span class="badge bg-warning text-dark">En cours</span>
                          <% } %>
                        </td>
                      </tr>
                    <% } %>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Vous n'avez pas encore d'historique d'emprunts.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
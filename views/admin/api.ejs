
<div class="container my-5">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Tableau de bord</a></li>
      <li class="breadcrumb-item active" aria-current="page">API Administrateur</li>
    </ol>
  </nav>
  
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-key me-2"></i>Votre token API</h4>
        </div>
        <div class="card-body">
          <% if(apiToken) { %>
            <div class="alert alert-success">
              <p class="mb-1">Token actif</p>
              <small>Généré le <%= new Date(user.tokenCreatedAt).toLocaleDateString() %></small>
            </div>
            <div class="mb-3">
              <label class="form-label">Votre token</label>
              <div class="input-group">
                <input 
                  type="text" 
                  class="form-control" 
                  value="<%= apiToken %>" 
                  id="apiTokenField" 
                  readonly
                >
                <button 
                  class="btn btn-outline-secondary" 
                  type="button" 
                  onclick="copyToClipboard('apiTokenField')"
                >
                  <i class="fas fa-copy"></i>
                </button>
              </div>
              <div class="form-text">Ce token est valable pendant 30 jours.</div>
            </div>
            <form action="/auth/generate-token" method="POST">
              <button type="submit" class="btn btn-outline-info w-100">
                <i class="fas fa-sync-alt me-2"></i>Régénérer le token
              </button>
            </form>
          <% } else { %>
            <div class="alert alert-warning">
              <p class="mb-0">Vous n'avez pas de token API actif</p>
            </div>
            <form action="/auth/generate-token" method="POST">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-key me-2"></i>Générer un token
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0"><i class="fas fa-book me-2"></i>Documentation API Administrateur</h4>
        </div>
        <div class="card-body">
          <div class="alert alert-info">
            <p class="mb-0">En tant qu'administrateur, vous avez accès à des endpoints API supplémentaires pour gérer les livres et les utilisateurs.</p>
          </div>
          
          <h5 class="mt-4">Authentification</h5>
          <p>Toutes les requêtes API nécessitent une authentification via le token API. Ajoutez le header suivant à chaque requête :</p>
          <div class="bg-light p-3 rounded mb-3">
            <code>Authorization: Bearer votre_token_api</code>
          </div>
          
          <h5 class="mt-4">Endpoints administrateur</h5>
          
          <div class="accordion" id="apiAccordion">
            <!-- Livres -->
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingBooks">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBooks" aria-expanded="true" aria-controls="collapseBooks">
                  <i class="fas fa-book me-2"></i>Gestion des livres
                </button>
              </h2>
              <div id="collapseBooks" class="accordion-collapse collapse show" aria-labelledby="headingBooks" data-bs-parent="#apiAccordion">
                <div class="accordion-body">
                  <!-- Ajouter un livre -->
                  <div class="card mb-3">
                    <div class="card-header">
                      <span class="badge bg-warning text-dark">POST</span>
                      <code>/api/books</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Ajouter un nouveau livre</p>
                      <h6>Corps de la requête :</h6>
                      <pre class="bg-light p-3 rounded"><code>{
  "titre": "Titre du livre",
  "auteur": "Nom de l'auteur",
  "categorie": "Catégorie",
  "description": "Description du livre",
  "isbn": "1234567890123",
  "anneePublication": 2025,
  "editeur": "Nom de l'éditeur",
  "quantiteTotale": 5
}</code></pre>
                    </div>
                  </div>
                  
                  <!-- Mettre à jour un livre -->
                  <div class="card mb-3">
                    <div class="card-header">
                      <span class="badge bg-info">PUT</span>
                      <code>/api/books/:id</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Mettre à jour un livre existant</p>
                      <h6>Corps de la requête :</h6>
                      <pre class="bg-light p-3 rounded"><code>{
  "titre": "Nouveau titre",
  "auteur": "Nouvel auteur",
  "categorie": "Nouvelle catégorie",
  "description": "Nouvelle description",
  "isbn": "1234567890123",
  "anneePublication": 2025,
  "editeur": "Nouvel éditeur",
  "quantiteTotale": 10
}</code></pre>
                    </div>
                  </div>
                  
                  <!-- Supprimer un livre -->
                  <div class="card">
                    <div class="card-header">
                      <span class="badge bg-danger">DELETE</span>
                      <code>/api/books/:id</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Supprimer un livre</p>
                      <p class="form-text">Note : Un livre ne peut pas être supprimé s'il est actuellement emprunté.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Utilisateurs -->
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingUsers">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="false" aria-controls="collapseUsers">
                  <i class="fas fa-users me-2"></i>Gestion des utilisateurs
                </button>
              </h2>
              <div id="collapseUsers" class="accordion-collapse collapse" aria-labelledby="headingUsers" data-bs-parent="#apiAccordion">
                <div class="accordion-body">
                  <!-- Liste des utilisateurs -->
                  <div class="card">
                    <div class="card-header">
                      <span class="badge bg-success">GET</span>
                      <code>/api/users</code>
                    </div>
                    <div class="card-body">
                      <p class="card-text">Récupérer la liste de tous les utilisateurs</p>
                      <h6>Paramètres optionnels :</h6>
                      <ul>
                        <li><code>search</code> - Recherche par nom, prénom ou email</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <h5 class="mt-4">Exemples d'utilisation</h5>
          
          <div class="bg-light p-3 rounded mb-3">
            <p class="mb-2"><strong>Ajouter un livre :</strong></p>
            <code>
              curl -X POST "http://localhost:3000/api/books" \<br>
              -H "Authorization: Bearer votre_token_api" \<br>
              -H "Content-Type: application/json" \<br>
              -d '{"titre":"Nouveau livre","auteur":"Auteur","categorie":"Roman","description":"Description du livre","isbn":"1234567890123","anneePublication":2025,"editeur":"Éditeur","quantiteTotale":5}'
            </code>
          </div>
          
          <div class="bg-light p-3 rounded mb-3">
            <p class="mb-2"><strong>Récupérer tous les utilisateurs :</strong></p>
            <code>
              curl -X GET "http://localhost:3000/api/users" \<br>
              -H "Authorization: Bearer votre_token_api"
            </code>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function copyToClipboard(elementId) {
    const copyText = document.getElementById(elementId);
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(copyText.value);
    
    // Afficher une notification
    alert('Token copié dans le presse-papiers');
  }
</script>
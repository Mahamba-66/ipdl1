
<div class="container my-5">
  <h1 class="mb-4"><i class="fas fa-users me-2"></i>Gestion des utilisateurs</h1>
  
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form action="/admin/users" method="GET">
        <div class="input-group">
          <input
            type="text"
            class="form-control"
            placeholder="Rechercher un utilisateur par nom, prénom ou email..."
            name="search"
            value="<%= search %>"
          >
          <button class="btn btn-primary" type="submit">
            <i class="fas fa-search me-1"></i>Rechercher
          </button>
        </div>
      </form>
    </div>
  </div>
  
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0"><i class="fas fa-list me-2"></i>Liste des utilisateurs</h4>
    </div>
    <div class="card-body">
      <% if(users.length === 0) { %>
        <div class="alert alert-info">
          <p class="mb-0">Aucun utilisateur trouvé. Veuillez modifier vos critères de recherche.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Date d'inscription</th>
                <th>Emprunts</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(user) { %>
                <tr>
                  <td><%= user.nom %></td>
                  <td><%= user.prenom %></td>
                  <td><%= user.email %></td>
                  <td><%= new Date(user.dateInscription).toLocaleDateString() %></td>
                  <td>
                    <% if(user.empruntActuel.length > 0) { %>
                      <span class="badge bg-success"><%= user.empruntActuel.length %></span>
                    <% } else { %>
                      <span class="badge bg-secondary">0</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/users/<%= user._id %>" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                      </a>
                      <form action="/admin/users/<%= user._id %>/block" method="POST">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir bloquer cet utilisateur ?');">
                          <i class="fas fa-ban"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="container my-5">
  <h1 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Tableau de bord administrateur</h1>
  
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white h-100 shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase">Utilisateurs</h6>
              <h2 class="display-4"><%= userCount %></h2>
            </div>
            <i class="fas fa-users fa-3x"></i>
          </div>
        </div>
        <div class="card-footer bg-transparent border-0">
          <a href="/admin/users" class="text-white">Voir tous les utilisateurs <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white h-100 shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase">Livres</h6>
              <h2 class="display-4"><%= bookCount %></h2>
            </div>
            <i class="fas fa-book fa-3x"></i>
          </div>
        </div>
        <div class="card-footer bg-transparent border-0">
          <a href="/books" class="text-white">Voir tous les livres <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark h-100 shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase">Emprunts</h6>
              <h2 class="display-4"><%= empruntsCount %></h2>
            </div>
            <i class="fas fa-book-reader fa-3x"></i>
          </div>
        </div>
        <div class="card-footer bg-transparent border-0">
          <span class="text-dark">Livres actuellement empruntés</span>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card bg-info text-white h-100 shadow">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-uppercase">API</h6>
              <h2 class="display-4"><i class="fas fa-key"></i></h2>
            </div>
            <i class="fas fa-code fa-3x"></i>
          </div>
        </div>
        <div class="card-footer bg-transparent border-0">
          <a href="/admin/api" class="text-white">Accéder à l'API <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Livres les plus empruntés</h4>
        </div>
        <div class="card-body">
          <% if(topBooks.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Emprunts</th>
                  </tr>
                </thead>
                <tbody>
                  <% topBooks.forEach(function(book) { %>
                    <tr>
                      <td><%= book.titre %></td>
                      <td><%= book.auteur %></td>
                      <td><span class="badge bg-primary"><%= book.empruntCount %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Aucun livre n'a encore été emprunté.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-success text-white">
          <h4 class="mb-0"><i class="fas fa-history me-2"></i>Derniers emprunts</h4>
        </div>
        <div class="card-body">
          <% if(recentLoans.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Utilisateur</th>
                    <th>Livre</th>
                    <th>Date</th>
                    <th>Statut</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentLoans.forEach(function(loan) { %>
                    <tr>
                      <td>
                        <% if(loan.userDetails && loan.userDetails.length > 0) { %>
                          <%= loan.userDetails[0].prenom %> <%= loan.userDetails[0].nom %>
                        <% } else { %>
                          Utilisateur inconnu
                        <% } %>
                      </td>
                      <td>
                        <% if(loan.bookDetails && loan.bookDetails.length > 0) { %>
                          <%= loan.bookDetails[0].titre %>
                        <% } else { %>
                          Livre inconnu
                        <% } %>
                      </td>
                      <td><%= new Date(loan.historique.dateEmprunt).toLocaleDateString() %></td>
                      <td>
                        <% if(loan.historique.dateRetour) { %>
                          <span class="badge bg-success">Retourné</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark">En cours</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Aucun emprunt n'a encore été effectué.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-12">
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h4 class="mb-0"><i class="fas fa-cog me-2"></i>Actions rapides</h4>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-3">
              <a href="/books/add" class="btn btn-success w-100 p-3">
                <i class="fas fa-plus-circle fa-2x mb-2"></i>
                <span class="d-block">Ajouter un livre</span>
              </a>
            </div>
            <div class="col-md-3">
              <a href="/admin/users" class="btn btn-primary w-100 p-3">
                <i class="fas fa-users fa-2x mb-2"></i>
                <span class="d-block">Gérer les utilisateurs</span>
              </a>
            </div>
            <div class="col-md-3">
              <a href="/books" class="btn btn-info w-100 p-3 text-white">
                <i class="fas fa-book fa-2x mb-2"></i>
                <span class="d-block">Gérer les livres</span>
              </a>
            </div>
            <div class="col-md-3">
              <a href="/admin/api" class="btn btn-secondary w-100 p-3">
                <i class="fas fa-key fa-2x mb-2"></i>
                <span class="d-block">Accéder à l'API</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
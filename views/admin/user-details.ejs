
<div class="container my-5">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Tableau de bord</a></li>
      <li class="breadcrumb-item"><a href="/admin/users">Utilisateurs</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= user.prenom %> <%= user.nom %></li>
    </ol>
  </nav>
  
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-user me-2"></i>Informations</h4>
        </div>
        <div class="card-body">
          <div class="text-center mb-4">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
              <i class="fas fa-user fa-3x text-primary"></i>
            </div>
            <h3><%= user.prenom %> <%= user.nom %></h3>
            <p class="text-muted"><%= user.email %></p>
          </div>
          
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><i class="fas fa-calendar-alt me-2"></i>Date d'inscription</span>
              <span><%= new Date(user.dateInscription).toLocaleDateString() %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><i class="fas fa-book-reader me-2"></i>Emprunts en cours</span>
              <span class="badge bg-success rounded-pill"><%= user.empruntActuel.length %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><i class="fas fa-history me-2"></i>Total des emprunts</span>
              <span class="badge bg-primary rounded-pill"><%= user.historique.length %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><i class="fas fa-key me-2"></i>API Token</span>
              <span><%= user.apiToken ? 'Actif' : 'Inactif' %></span>
            </li>
          </ul>
          
          <div class="d-grid gap-2 mt-3">
            <form action="/admin/users/<%= user._id %>/block" method="POST">
              <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Êtes-vous sûr de vouloir bloquer cet utilisateur ?');">
                <i class="fas fa-ban me-2"></i>Bloquer l'utilisateur
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
          <h4 class="mb-0"><i class="fas fa-book-reader me-2"></i>Emprunts en cours</h4>
        </div>
        <div class="card-body">
          <% if(user.empruntActuel.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Livre</th>
                    <th>Auteur</th>
                    <th>ISBN</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% user.empruntActuel.forEach(function(book) { %>
                    <tr>
                      <td><a href="/books/<%= book._id %>"><%= book.titre %></a></td>
                      <td><%= book.auteur %></td>
                      <td><%= book.isbn %></td>
                      <td>
                        <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-info-circle me-1"></i>Détails
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Cet utilisateur n'a aucun emprunt en cours.</p>
            </div>
          <% } %>
        </div>
      </div>
      
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h4 class="mb-0"><i class="fas fa-history me-2"></i>Historique des emprunts</h4>
        </div>
        <div class="card-body">
          <% if(user.historique.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Livre</th>
                    <th>Emprunté le</th>
                    <th>Retourné le</th>
                    <th>Statut</th>
                  </tr>
                </thead>
                <tbody>
                  <% user.historique.forEach(function(record) { %>
                    <% if(record.livre) { %>
                      <tr>
                        <td>
                          <a href="/books/<%= record.livre._id %>"><%= record.livre.titre %></a>
                          <small class="text-muted d-block"><%= record.livre.auteur %></small>
                        </td>
                        <td><%= new Date(record.dateEmprunt).toLocaleDateString() %></td>
                        <td>
                          <% if(record.dateRetour) { %>
                            <%= new Date(record.dateRetour).toLocaleDateString() %>
                          <% } else { %>
                            -
                          <% } %>
                        </td>
                        <td>
                          <% if(record.dateRetour) { %>
                            <span class="badge bg-success">Retourné</span>
                          <% } else { %>
                            <span class="badge bg-warning text-dark">En cours</span>
                          <% } %>
                        </td>
                      </tr>
                    <% } %>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <p class="mb-0">Cet utilisateur n'a pas encore d'historique d'emprunts.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
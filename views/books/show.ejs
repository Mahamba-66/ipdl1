

<div class="container my-5">
  <div class="row">
    <div class="col-md-4 mb-4">
      <img src="<%= book.image %>" class="img-fluid rounded shadow-sm" alt="<%= book.titre %>">
      <div class="mt-3">
        <% if(currentUser) { %>
          <% if(book.quantiteDisponible > 0) { %>
            <% if(Array.isArray(currentUser?.empruntActuel) && !currentUser.empruntActuel.includes(book._id.toString())) { %>
              <form action="/books/<%= book._id %>/emprunter" method="POST">
                <button type="submit" class="btn btn-success w-100">
                  <i class="fas fa-book-reader me-2"></i>Emprunter
                </button>
              </form>
            <% } else { %>
              <form action="/books/<%= book._id %>/retourner" method="POST">
                <button type="submit" class="btn btn-warning w-100">
                  <i class="fas fa-undo me-2"></i>Retourner ce livre
                </button>
              </form>
            <% } %>
          <% } else { %>
            <button class="btn btn-danger w-100" disabled>
              <i class="fas fa-times-circle me-2"></i>Indisponible
            </button>
          <% } %>
          
          <% if(currentUser.role === 'admin') { %>
            <div class="d-flex gap-2 mt-3">
              <a href="/books/edit/<%= book._id %>" class="btn btn-primary flex-grow-1">
                <i class="fas fa-edit me-1"></i>Modifier
              </a>
              <form action="/books/<%= book._id %>?_method=DELETE" method="POST" class="flex-grow-1">
                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce livre ?');">
                  <i class="fas fa-trash-alt me-1"></i>Supprimer
                </button>
              </form>
            </div>
          <% } %>
        <% } else { %>
          <div class="alert alert-info">
            <p class="mb-0">Connectez-vous pour emprunter ce livre</p>
          </div>
          <a href="/auth/login" class="btn btn-primary w-100">
            <i class="fas fa-sign-in-alt me-2"></i>Se connecter
          </a>
        <% } %>
      </div>
    </div>
    
    <div class="col-md-8">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/books">Catalogue</a></li>
          <li class="breadcrumb-item active" aria-current="page"><%= book.titre %></li>
        </ol>
      </nav>
      
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h2 class="card-title mb-3"><%= book.titre %></h2>
          <h5 class="card-subtitle mb-2 text-muted">Par <%= book.auteur %></h5>
          
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-info text-dark"><%= book.categorie %></span>
            <span class="badge bg-secondary">ISBN: <%= book.isbn %></span>
            <span class="badge bg-secondary"><%= book.anneePublication %></span>
            <span class="badge bg-<%= book.quantiteDisponible > 0 ? 'success' : 'danger' %>">
              <%= book.quantiteDisponible %> sur <%= book.quantiteTotale %> disponible(s)
            </span>
          </div>
          
          <h5 class="mt-4">Description</h5>
          <p class="card-text"><%= book.description %></p>
          
          <div class="row mt-4">
            <div class="col-md-6">
              <h5>Détails</h5>
              <table class="table table-sm">
                <tbody>
                  <tr>
                    <th>Éditeur</th>
                    <td><%= book.editeur %></td>
                  </tr>
                  <tr>
                    <th>Année de publication</th>
                    <td><%= book.anneePublication %></td>
                  </tr>
                  <tr>
                    <th>ISBN</th>
                    <td><%= book.isbn %></td>
                  </tr>
                  <tr>
                    <th>Disponibilité</th>
                    <td>
                      <% if(book.quantiteDisponible > 0) { %>
                        <span class="text-success">
                          <i class="fas fa-check-circle me-1"></i>
                          <%= book.quantiteDisponible %> exemplaire(s) disponible(s)
                        </span>
                      <% } else { %>
                        <span class="text-danger">
                          <i class="fas fa-times-circle me-1"></i>
                          Indisponible
                        </span>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <th>Ajouté le</th>
                    <td><%= new Date(book.dateAjout).toLocaleDateString() %></td>
                  </tr>
                </tbody>
              </table>
            </div>
            
            <% if(currentUser && currentUser.role === 'admin') { %>
              <div class="col-md-6">
                <h5>Statut</h5>
                <div class="mb-3">
                  <div class="progress">
                    <div 
                      class="progress-bar <%= book.quantiteDisponible === 0 ? 'bg-danger' : 'bg-success' %>" 
                      role="progressbar" 
                      style="width: <%= ((book.quantiteTotale - book.quantiteDisponible) / book.quantiteTotale * 100).toFixed(0) %>%"
                    >
                      <%= Math.round((book.quantiteTotale - book.quantiteDisponible) / book.quantiteTotale * 100) %>%
                    </div>
                  </div>
                  <small class="text-muted">
                    <%= book.quantiteTotale - book.quantiteDisponible %> emprunté(s) sur <%= book.quantiteTotale %> exemplaire(s)
                  </small>
                  
                </div>
                
                <% if(book.empruntePar.length > 0) { %>
                  <h6>Emprunté par :</h6>
                  <ul class="list-group">
                    <% book.empruntePar.forEach(function(user) { %>
                      <li class="list-group-item">
                        <%= user.prenom %> <%= user.nom %>
                      </li>
                    <% }); %>
                  </ul>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>